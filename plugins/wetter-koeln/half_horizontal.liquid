<div class="view view--half_horizontal">
<div class="layout layout--row" style="padding: 6px 10px; align-items: stretch; justify-content: flex-start;">

  {% if available == false %}
  <div class="flex flex--center-x flex--center-y grow">
    <div style="font-size: 18px; font-weight: 700;">Keine Wetter-Daten</div>
  </div>
  {% else %}

  <!-- Left: Info -->
  <div class="flex flex--col flex--center-y" style="width: 130px;">
    <div style="font-size: 36px; font-weight: 700; line-height: 1; color: #000;">{{ current.temp | floor }}°</div>
    <div style="font-size: 12px; font-weight: 700; color: #000;">{{ current.description }}</div>
    <div style="font-size: 11px; font-weight: 600; color: #000; margin-top: 4px;">{{ daily.today.min | floor }}° / {{ daily.today.max | floor }}°</div>
    <div style="font-size: 11px; font-weight: 600; color: #000;">Regen {{ daily.today.precipitation_prob }}%</div>
    {% if bike_forecast %}
    <div style="border: 2px solid #000; padding: 2px 4px; margin-top: 6px; text-align: center;{% if bike_forecast.status == 'wet' %} background: red; color: #fff;{% endif %}">
      <div style="font-size: 9px; font-weight: 700;">{{ bike_forecast.label }}</div>
      <div style="font-size: 11px; font-weight: 700;">{{ bike_forecast.message }}</div>
    </div>
    {% endif %}
  </div>

  <!-- Right: Chart -->
  <div style="flex: 1; padding-left: 8px; height: 100%; border-left: 2px solid #000;">
    {% if hourly and hourly.size > 0 %}

    {% assign min_temp = 100 %}
    {% assign max_temp = -50 %}
    {% for h in hourly %}
      {% assign t = h.temp | floor %}
      {% if t < min_temp %}{% assign min_temp = t %}{% endif %}
      {% if t > max_temp %}{% assign max_temp = t %}{% endif %}
    {% endfor %}
    {% assign temp_range = max_temp | minus: min_temp %}
    {% if temp_range == 0 %}{% assign temp_range = 1 %}{% endif %}

    <svg viewBox="0 0 700 180" style="width: 100%; height: 100%; display: block;">
      {% comment %} Rain bars - positioned by actual hour {% endcomment %}
      {% for h in hourly %}
        {% assign hparts = h.time | split: ":" %}
        {% assign hval = hparts[0] | plus: 0 %}
        {% assign bx = hval | times: 28 | plus: 10 %}
        {% if h.precipitation_prob > 5 %}
          {% assign bh = h.precipitation_prob | times: 80 | divided_by: 100 %}
          {% assign by = 140 | minus: bh %}
          {% if h.precipitation_prob > 50 %}
          <rect x="{{ bx }}" y="{{ by }}" width="20" height="{{ bh }}" fill="none" stroke="red" stroke-width="2" />
          {% else %}
          <rect x="{{ bx }}" y="{{ by }}" width="20" height="{{ bh }}" fill="none" stroke="red" stroke-width="1.5" />
          {% endif %}
          {% if h.precipitation_prob > 40 %}
            {% assign lx = bx | plus: 10 %}
            <text x="{{ lx }}" y="{{ by | minus: 2 }}" text-anchor="middle" style="font-size: 8px; font-weight: 700;">{{ h.precipitation_prob }}%</text>
          {% endif %}
        {% endif %}
      {% endfor %}

      {% comment %} Temperature line - sorted by hour 0-23 {% endcomment %}
      {% assign temp_points = "" %}
      {% for hour_slot in (0..23) %}
        {% for h in hourly %}
          {% assign hparts = h.time | split: ":" %}
          {% assign hval = hparts[0] | plus: 0 %}
          {% if hval == hour_slot %}
            {% assign px = hval | times: 28 | plus: 21 %}
            {% assign t = h.temp | floor %}
            {% assign ty = t | minus: min_temp | times: 100 | divided_by: temp_range %}
            {% assign py = 135 | minus: ty %}
            {% capture temp_points %}{{ temp_points }}{{ px }},{{ py }} {% endcapture %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      <polyline fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" points="{{ temp_points }}" />

      {% comment %} Temperature labels every 3h {% endcomment %}
      {% for h in hourly %}
        {% assign hparts = h.time | split: ":" %}
        {% assign hval = hparts[0] | plus: 0 %}
        {% assign mod3 = hval | modulo: 3 %}
        {% if mod3 == 0 %}
          {% assign px = hval | times: 28 | plus: 21 %}
          {% assign t = h.temp | floor %}
          {% assign ty = t | minus: min_temp | times: 100 | divided_by: temp_range %}
          {% assign py = 135 | minus: ty | minus: 7 %}
          <text x="{{ px }}" y="{{ py }}" text-anchor="middle" style="font-size: 9px; font-weight: 700;">{{ t }}°</text>
        {% endif %}
      {% endfor %}

      {% comment %} NOW marker {% endcomment %}
      {% assign current_hour = trmnl.system.local_hour | plus: 0 %}
      {% assign now_x = current_hour | times: 28 | plus: 10 %}
      <line x1="{{ now_x }}" y1="10" x2="{{ now_x }}" y2="140" stroke="#fff" stroke-width="6" />
      <line x1="{{ now_x }}" y1="10" x2="{{ now_x }}" y2="140" stroke="red" stroke-width="2" stroke-dasharray="4,3" />

      {% comment %} X-axis: fixed 0-24h {% endcomment %}
      <line x1="10" y1="141" x2="690" y2="141" stroke="#000" stroke-width="1" />
      {% for hour in (0..24) %}
        {% assign tx = hour | times: 28 | plus: 10 %}
        {% if hour == 24 %}{% assign tx = 690 %}{% endif %}
        {% assign hour_mod = hour | modulo: 3 %}
        {% if hour_mod == 0 %}
          <line x1="{{ tx }}" y1="141" x2="{{ tx }}" y2="147" stroke="#000" stroke-width="1" />
          <text x="{{ tx }}" y="160" text-anchor="middle" style="font-size: 9px; font-weight: 600;">{{ hour }}</text>
        {% else %}
          <line x1="{{ tx }}" y1="141" x2="{{ tx }}" y2="145" stroke="#000" stroke-width="0.8" />
        {% endif %}
      {% endfor %}

      {% comment %} Legend {% endcomment %}
      <line x1="20" y1="175" x2="45" y2="175" stroke="#000" stroke-width="3" />
      <text x="50" y="178" style="font-size: 8px; font-weight: 600;">Temp</text>
      <rect x="100" y="170" width="10" height="10" fill="none" stroke="red" stroke-width="1.5" />
      <text x="114" y="178" style="font-size: 8px; font-weight: 600;">Regen%</text>
    </svg>
    {% endif %}
  </div>

  {% endif %}
</div>

<div class="title_bar">
  <span class="title"><strong>Köln</strong></span>
  <span class="instance">{{ trmnl.system.local_time }}</span>
</div>
</div>
